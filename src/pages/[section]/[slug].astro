---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import LegacyRedirect from "../../layouts/LegacyRedirect.astro";
import { articleUrl, compareArticles } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => data.status === "published");
  return articles.map((article) => ({ params: { section: article.data.section, slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const related = (await getCollection("articles", ({ data, id }) => data.status === "published" && data.section === article.data.section && id !== article.id)).sort(compareArticles).slice(0, 4);
const isLegacyGuideUrl = article.data.section === "gugudata-io";
const guideUrl = new URL(articleUrl(article), Astro.site).href;
const legacyDestination = article.data.canonicalUrl ?? guideUrl;
---

{isLegacyGuideUrl
  ? <LegacyRedirect title={article.data.title} destination={legacyDestination} lang={article.data.lang} />
  : <ArticleLayout article={article} headings={headings} related={related}><Content /></ArticleLayout>}
