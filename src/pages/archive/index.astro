---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { compareArticles } from "../../lib/content";

const archived = (await getCollection("articles", ({ data }) => data.status === "archived")).sort(compareArticles);
---

<BaseLayout title="历史资料" description="咕咕数据知识库收录的历史技术文章、产品资料与实践记录。">
  <section class="listing-hero">
    <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>归档</span></nav>
    <h1>历史资料</h1>
    <p>这些文章记录了不同阶段的技术、产品与实践经验，部分信息可能随时间变化。</p>
  </section>
  <section class="content-section listing-section">
    <div class="section-heading"><h2>归档资料</h2><span>{archived.length} 篇</span></div>
    <ArticleList articles={archived} />
  </section>
</BaseLayout>
